# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# ---- Runtime -----------------------------------------------------------
AGENTMESH_ENVIRONMENT=development        # development | staging | production
AGENTMESH_LOG_LEVEL=INFO
AGENTMESH_LOG_JSON=false

# ---- LLM providers -----------------------------------------------------
# Priority order, comma separated. First healthy provider wins; the rest are
# fallbacks. Leave empty to run agents in rule-based mode (no LLM calls).
AGENTMESH_LLM_PROVIDERS=openai,huggingface,ollama

# OpenAI
OPENAI_API_KEY=
AGENTMESH_OPENAI_MODEL=gpt-4o-mini

# Hugging Face Inference Providers (OpenAI-compatible router)
HF_TOKEN=
AGENTMESH_HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Ollama (local: http://localhost:11434, cloud: https://ollama.com + key)
AGENTMESH_OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
AGENTMESH_OLLAMA_MODEL=llama3.1

# ---- Agent hosting -----------------------------------------------------
AGENTMESH_TASK_STORE_URL=memory          # memory | sqlite+aiosqlite:///agentmesh.db | postgresql+asyncpg://...
AGENTMESH_AUTH_MODE=none                 # none | api_key | jwt | api_key_or_jwt
AGENTMESH_API_KEYS=                      # name:key pairs, comma separated, e.g. orchestrator:s3cr3t
AGENTMESH_JWT_SECRET=
AGENTMESH_JWT_AUDIENCE=agentmesh
AGENTMESH_PUSH_SIGNING_SECRET=
