# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ======================================================================================
# LLM providers (all optional: without them agents fall back to rule-based behaviour,
# except the Google ADK and Microsoft Agent Framework agents, which require one)
# ======================================================================================
# Failover order, comma separated. First healthy provider wins.
AGENTMESH_LLM_PROVIDERS=openai,huggingface,ollama

# OpenAI
OPENAI_API_KEY=
AGENTMESH_OPENAI_MODEL=gpt-4o-mini

# Hugging Face Inference Providers (OpenAI-compatible router)
HF_TOKEN=
AGENTMESH_HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Ollama: local daemon (http://localhost:11434) or Ollama Cloud (https://ollama.com + key)
AGENTMESH_OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
AGENTMESH_OLLAMA_MODEL=llama3.1

# ======================================================================================
# Runtime
# ======================================================================================
AGENTMESH_ENVIRONMENT=development       # development | staging | production (refuses to start unauthenticated)
AGENTMESH_LOG_LEVEL=INFO
AGENTMESH_LOG_JSON=false
AGENTMESH_TASK_STORE_URL=memory         # memory | sqlite+aiosqlite:///agentmesh.db | postgresql+asyncpg://...

# Authentication for a single agent: none | api_key | jwt | api_key_or_jwt
AGENTMESH_AUTH_MODE=none
AGENTMESH_API_KEYS=                     # name:key pairs, comma separated
AGENTMESH_JWT_SECRET=
AGENTMESH_JWT_AUDIENCE=agentmesh

# Webhook (push notification) signing
AGENTMESH_PUSH_SIGNING_SECRET=

# ======================================================================================
# Service-to-service
# ======================================================================================
AGENTMESH_REGISTRY_URL=                 # e.g. http://localhost:9100 (orchestrator, gateway, CLI)
AGENTMESH_STATIC_AGENT_URLS=            # alternative to a registry: comma separated agent URLs
AGENTMESH_OUTBOUND_API_KEY=             # credential this service presents to the agents it calls

# MCP bridge (agent: mcp-bridge)
AGENTMESH_MCP_SERVER_COMMAND=           # e.g. npx -y @modelcontextprotocol/server-everything
AGENTMESH_MCP_SERVER_URL=               # or a streamable-HTTP endpoint

# ======================================================================================
# docker compose
# ======================================================================================
AGENTMESH_SERVICE_KEY=                  # REQUIRED: shared by the gateway, orchestrator, registry and agents
AGENTMESH_CLIENT_API_KEYS=              # REQUIRED: keys clients use at the gateway, e.g. alice:long-random-key
POSTGRES_PASSWORD=                      # REQUIRED
AGENTMESH_PUBLIC_URL=http://localhost:9200
REGISTER_LLM_AGENTS=                    # set to 1 when running with --profile llm
